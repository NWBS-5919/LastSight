# 실제 값을 채운 뒤 .env로 복사해서 사용 (.env는 git에 올라가지 않음)

# BDAI(Superb AI) 플랫폼 — 테넌트 설정 > API 키 화면에서 발급
SUPERB_AI_TENANT=
SUPERB_AI_API_KEY=

# BDAI에 배포한 PPE(person/helmet/vest) 모델의 deployment ID
# (c.deployments.create(model_id=...) 로 생성, c.deployments.list() 로 확인)
PPE_DEPLOYMENT_ID=

# BDAI에 배포한 fire/smoke 커스텀 모델의 deployment ID (비워두면 ZERO 제로샷으로 폴백)
# 커스텀 모델은 학습 데이터의 장면 다양성 부족으로 ZERO보다 일반화가 떨어져 기본은 비움
# (development_log.md 32번 참고)
FIRE_SMOKE_DEPLOYMENT_ID=

# AI Hub(aihub.or.kr) — 마이페이지 > Open API 인증키 발급에서 확인
AIHUB_API_KEY=

# FastAPI 서버
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# 참고: 프론트엔드(Vite)는 이 최상위 .env를 읽지 않는다(Vite는 frontend/ 안의 .env만
# 읽음). 로컬 개발 모드에서는 코드가 자동으로 http://localhost:8000을 바라보므로 별도
# 설정이 필요 없다 — 다른 주소를 쓰고 싶을 때만 frontend/.env.local에
# VITE_API_BASE_URL=... 을 추가하면 된다(frontend/src/api.ts 참고).
